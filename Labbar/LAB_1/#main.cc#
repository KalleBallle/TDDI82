void print( std::vector<std::string> const& text)
{
    std::copy(text.begin(), text.end(), 
              std::ostream_iterator<std::string>(std::cout, " "));
    std::cout << std::endl;
}

void print_unique(std::vector<std::string>  & text)
{
    std::string longest_word {} ;
    longest_word = *max_element(text.begin(),text.end(),[&text](std::string const& word1, std::string const& word2 ) {return word1.size() < word2.size();});
  		
    for_each(text.begin(),unique(text.begin(),text.end()),
             [&text, &longest_word](std::string const& word)
             {
                 std::cout << std::setw(longest_word.size()) << word << ' ' << count(text.begin(),text.end(),word) << std::endl;
             }
        );
    
}

void remove_word(std::vector<std::string> & text, std::string const& parameter)
{
    text.erase(std::remove(text.begin(),text.end(),parameter),text.end());
}

void substitute(std::vector<std::string> & text,std::string const& old_word,std::string const& new_word)
{
 
    std::replace(text.begin(), text.end(), old_word, new_word);
}

void table(std::vector<std::string>   text)
{
    std::sort(text.begin(), text.end());
    std::cout << std::left;
    print_unique(text);	   
}

void frequency(std::vector<std::string>  text)
{
    std::sort(text.begin(), text.end(),
              [&text](std::string const& word1, std::string const& word2)
              {
                  int num1{static_cast<int>(std::count(text.begin(), text.end(), word1))};
                  int num2{static_cast<int>(std::count(text.begin(), text.end(), word2))};

                  if(num1 != num2) {
                      return num1 > num2 ;

                  }
                  return word1 < word2;

              });

    std::cout << std::right;
    print_unique(text);
}

int main(int argc, char** argv)
{ 
    std::vector<std::string> text{};
    std::string filename{};
    std::vector<std::string> arguments{argv,argv+argc};

    arguments.erase(arguments.begin()); //Tar bort "/a.out
    if(arguments.size() < 1)
    {
        std::cout << "saknar fil" << std::endl;
        return 1;
    }
 
    filename = *arguments.begin();


      
    arguments.erase(arguments.begin());
  
    if(arguments.size() < 1)
    {
        std::cout << "fel antal argument" << std::endl ;
        return 1;
    }

    std::ifstream file{};

    file.open(filename);

    if(file.is_open())
    {
        text = std::vector<std::string>(std::istream_iterator<std::string>(file),
                                        std::istream_iterator<std::string>());
    }
    else 
    {  
        std::cout << "Could not open file \"" << filename << std::endl;
    
        return 1;
    };
 

    try
    {
        for_each( arguments.begin(),arguments.end(),[&text](std::string a)
        {
            std::string flag{a};
            std::string parameter{};
   
            if (a.find('=') != a.npos)
            {
                flag.erase(std::find(flag.begin(),flag.end(),'=')+1,flag.end());
                parameter = a.substr(a.find_first_of('=') + 1);
             
                if(parameter.empty())
                {
                   throw std::logic_error("wrong parameter");
                }
               
            }

            if(flag == "--print")
            {
                print(text);
            }
            else if(flag == "--table")
            {
                table(text);
            }
            else if (flag == "--frequency")
            {
                frequency(text);
            }
            else if (flag == "--remove=")
            {
                remove_word(text, parameter);
            }
            else if (flag == "--substitute=")
            {
                
                std::string old_word{parameter};
                
                if(old_word.find('+') == old_word.npos)
                {
                  throw std::logic_error("Wrong commmand syntax. Could not find '+'");
                }
                
                old_word.erase(std::find(old_word.begin(),old_word.end(),'+') ,old_word.end());
                std::string new_word{parameter.substr(parameter.find_first_of('+') + 1)};

           
           
                if(old_word.empty() || new_word.empty())
                {
                  throw std::logic_error("parameter values wrong");
                }
           
                substitute(text, old_word, new_word);
            }
            else
            {
              throw std::logic_error("flag wrong");
            }
        });
    }
    catch(const std::logic_error & e)
    {
        std::cout << e.what();
        return 1;
    }
}



